# Configuration base de données TimescaleDB
POSTGRES_USER=postgres
# Choose a strong password. It is never committed: .env is git-ignored.
POSTGRES_PASSWORD=
POSTGRES_DB=dalarna_dt

# Clés API
TRAFIKVERKET_API_KEY=votre_cle_ici

# --- Nouvelles sources nationales (connectors/) ---

# Lantmäteriet - National Geodata Platform. Le produit/service exact doit être
# choisi et souscrit sur https://apimanager.lantmateriet.se avant utilisation
# (l'accès varie selon le produit : cf. dalarna-data-mapping.md section 4.1).
LANTMATERIET_API_KEY=
LANTMATERIET_BASE_URL=
LANTMATERIET_COLLECTION=

# SCB (Statistics Sweden) - PxWebApi v2, aucune authentification requise.
# Optionnel : fixer un table id précis plutôt que de le rechercher par mot-clé.
SCB_TABLE_ID=
SCB_TABLE_QUERY=Folkmängd
SCB_REGION_CODE=20

# Skogsstyrelsen - Skogliga grunddata API, OAuth 2.0 Client Credentials.
# Enregistrer une application sur https://www.skogsstyrelsen.se/skogsstyrelsensapi
# pour obtenir ClientId/ClientSecret (jeton valable 60 minutes).
SKOGSSTYRELSEN_CLIENT_ID=
SKOGSSTYRELSEN_CLIENT_SECRET=
SKOGSSTYRELSEN_AOI_BBOX=

# SGU - OGC API Features, accès ouvert pour les collections groundwater. Aucune
# clé requise.

# --- Application / Admin Control Panel ---
# Admin login for /admin and every mutating /api/control/* endpoint. No defaults:
# if ADMIN_PASSWORD is empty, admin login is disabled.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Signs the admin session cookie. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# If empty, a random value is used per start (admins are logged out on every restart).
SESSION_SECRET=
# Let Main Interface visitors run simulations without an admin login (true/false).
PUBLIC_SIMULATION=true

# Grafana (docker-compose). Required; no default password exists.
GRAFANA_ADMIN_PASSWORD=
# Set to true only if the legacy cockpit page must embed Grafana panels anonymously (read-only).
GRAFANA_ANONYMOUS_VIEWER=false
