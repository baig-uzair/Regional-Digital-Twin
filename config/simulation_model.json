{
  "model_version": "1.2.0",
  "name": "Dalarna Cross-Sector Causal Dependency Model",
  "description": "Propagates demographic, infrastructural and environmental driver variations across Dalarna's 15 municipalities.",
  "dependencies": {
    "population_growth": {
      "driver_source": "SCB",
      "coefficients": {
        "traffic_demand": 1.2,
        "infrastructure_pressure": 0.85,
        "land_development": 1.0,
        "forest_reduction": -0.20,
        "water_exposure": 0.60,
        "weather_effect": 0.0
      },
      "weights": {
        "population": 0.25,
        "food_risk": 0.20,
        "snow_flood_risk": 0.20,
        "infrastructure_risk": 0.20,
        "environment_risk": 0.15
      }
    }
  },
  "default_thresholds": {
    "low": 0.30,
    "medium": 0.60,
    "high": 0.80,
    "critical": 1.00
  },
  "municipalities_baseline": {
